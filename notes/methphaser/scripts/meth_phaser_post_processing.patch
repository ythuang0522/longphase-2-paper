+def new_block_start_loc(final_blocks, start_loc, pos):
+    # local patch: the PS of a LongPhase block need not lie inside the block (it can precede its
+    # first phased SNV); then the lookup by PS fails (returns int -1). Look the block up by the
+    # record position instead, and keep the old PS if that fails too.
+    for loc in (int(start_loc), int(pos)):
+        new = get_altered_block_start_loc(final_blocks, loc)
+        if new != -1:
+            return str(new)
+    return start_loc
